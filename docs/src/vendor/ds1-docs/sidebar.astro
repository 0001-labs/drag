---
const { sidebar } = Astro.locals.starlightRoute;
const { sourceHref } = Astro.props;
---
<ds-sidebar label="Documentation" tree data-entries={JSON.stringify(sidebar)}>
  {sourceHref && <a {...{ slot: 'footer' }} href={sourceHref}>GitHub</a>}
</ds-sidebar>
<script>
  import '../ds1/3-unit/ds-sidebar';
  import type { SidebarItem } from '../ds1/3-unit/ds-sidebar';
  // The documentation as folders and pages, as files stand in a folder: each group a folder with its arrow
  // before its name, each page under it, the page being read chosen. Choosing a page goes to it; choosing a
  // folder opens or closes it. A press with ⌘ or Ctrl opens the page beside this one, as a link does.
  type Entry = { label: string; href?: string; isCurrent?: boolean; entries?: Entry[] };
  const sidebar = document.querySelector('ds-sidebar[data-entries]')!;
  const entries: Entry[] = JSON.parse(sidebar.dataset.entries ?? '[]');
  const collapsed = new Set<string>();
  const pages = new Map<string, string>();
  function rows(entries: Entry[], depth = 0, parent = ''): SidebarItem[] {
    return entries.flatMap((entry, index) => {
      const id = entry.href ?? `${parent}/${index}`;
      if (!entry.entries) {
        if (entry.href) pages.set(id, entry.href);
        return [{ id, label: entry.label, depth, icon: 'page', selected: entry.isCurrent }];
      }
      const item: SidebarItem = { id, label: entry.label, depth, icon: 'folder', expanded: !collapsed.has(id) };
      return [item, ...(item.expanded ? rows(entry.entries, depth + 1, id) : [])];
    });
  }
  const draw = (focus?: string) => {
    sidebar.items = rows(entries);
    if (focus) void sidebar.updateComplete.then(() => sidebar.focusItem(focus));
  };
  const toggle = (id: string, expanded: boolean) => {
    if (expanded) collapsed.delete(id); else collapsed.add(id);
    draw(id);
  };
  let beside = false;
  sidebar.addEventListener('click', event => { beside = event.metaKey || event.ctrlKey; }, true);
  sidebar.addEventListener('keydown', () => { beside = false; }, true);
  const choose = (id: string) => {
    const href = pages.get(id);
    if (!href) { toggle(id, collapsed.has(id)); return; }
    if (beside) window.open(href, '_blank', 'noopener');
    else if (href !== location.pathname) location.assign(href);
  };
  sidebar.addEventListener('sidebar-toggle', event => { const { id, expanded } = (event as CustomEvent).detail; toggle(id, expanded); });
  sidebar.addEventListener('sidebar-select', event => choose((event as CustomEvent).detail.id));
  sidebar.addEventListener('sidebar-activate', event => choose((event as CustomEvent).detail.id));
  draw();
  void sidebar.updateComplete.then(() => sidebar.scrollToCurrent());
</script>
<style>
  ds-sidebar { display: block; height: 100%; width: 100%; }
  a { display: block; color: inherit; text-decoration: none; line-height: var(--ds-unit); }
  a:hover { text-decoration: underline; }
</style>
