---
import MyHeader from '../components/MyHeader.astro';
import MySidebar from '../components/MySidebar.astro';
---

<div class="drag-grid" aria-hidden="true"></div>
<MyHeader />
<div id="sidebar-overlay" class="sidebar-overlay"></div>
<div class="main-container">
  <aside id="sidebar" class="sidebar">
    <MySidebar />
  </aside>
  <div class="sidebar-gap" aria-hidden="true"></div>
  <main class="main-content">
    <slot />
  </main>
</div>
<script>
  import { defineDragElements } from '../../../src/elements';
  import { setupDocsInteractions } from '../scripts/docs-interactions';

  defineDragElements();
  setupDocsInteractions();
</script>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-width: 320px;
    background: var(--drag-docs-sidebar-bg);
    color: var(--drag-docs-header-text);
    font-family: var(--drag-docs-typeface);
  }

  body {
    overflow: hidden;
  }

  .drag-grid {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--drag-docs-grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--drag-docs-grid-line) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.36;
  }

  .main-container {
    position: relative;
    z-index: 1;
    display: flex;
    height: calc(100vh - 60px);
    overflow: hidden;
  }

  .sidebar {
    width: 280.5px;
    min-width: 280.5px;
    overflow-y: auto;
    border-right: 1px solid var(--drag-docs-header-border);
    background: var(--drag-docs-sidebar-bg);
    z-index: 100;
  }

  .sidebar-gap {
    width: 20px;
    min-width: 20px;
    height: 100%;
    border-right: 1px solid var(--drag-docs-header-border);
    background: var(--drag-docs-sidebar-bg);
  }

  .main-content {
    flex: 1;
    overflow-y: auto;
    background: var(--drag-docs-content-bg);
  }

  .main-pane {
    padding: 40px;
  }

  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 60px 0 0;
    z-index: 99;
    background: rgb(0 0 0 / 54%);
    opacity: 0;
    pointer-events: none;
  }

  .sidebar-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    border-radius: 4px;
    background: light-dark(#c0c0c0, #3a3a3a);
  }

  @media (max-width: 768px) {
    .sidebar {
      position: fixed;
      top: 60px;
      left: 0;
      height: calc(100vh - 60px);
      transform: translateX(-100%);
      transition: transform 0.3s ease;
    }

    .sidebar.open {
      transform: translateX(0);
    }

    .sidebar-gap {
      display: none;
    }

    .sidebar-overlay {
      display: block;
      transition: opacity 0.3s ease;
    }

    .main-content {
      width: 100%;
    }

    .main-pane {
      padding: 20px;
    }
  }
</style>
