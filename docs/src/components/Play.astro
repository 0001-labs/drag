---
/** Play: an Ezo board on Drag, each drag measured. */
import '../../../play/style.css';
---
<div class="play-host" data-play data-ds-not-prose></div>
<script>
  import { mountPlay } from '../../../play/mount';
  for (const host of document.querySelectorAll<HTMLElement>('[data-play]')) mountPlay(host);
</script>
