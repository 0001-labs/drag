{
  "name": "@0001-labs/drag",
  "version": "0.2.0-alpha.0",
  "description": "A small framework-agnostic drag-and-drop engine with Web Component helpers.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "packageManager": "pnpm@10.30.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0001-labs/drag.git"
  },
  "bugs": {
    "url": "https://github.com/0001-labs/drag/issues"
  },
  "homepage": "https://drag.0001.dev",
  "keywords": [
    "drag",
    "drop",
    "drag-and-drop",
    "dnd",
    "typescript",
    "web-components",
    "accessibility"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/elements.*"
  ],
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js",
      "require": "./dist/elements.cjs"
    },
    "./sortable": {
      "types": "./dist/sortable.d.ts",
      "import": "./dist/sortable.js",
      "require": "./dist/sortable.cjs"
    },
    "./grid": {
      "types": "./dist/grid.d.ts",
      "import": "./dist/grid.js",
      "require": "./dist/grid.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "vite --host 127.0.0.1",
    "playground:dev": "vite --config vite.playground.config.ts",
    "playground:build": "vite build --config vite.playground.config.ts",
    "docs:build": "astro build --root docs",
    "docs:dev": "astro dev --root docs --host 127.0.0.1 --port 5197",
    "docs:preview": "astro preview --root docs --host 127.0.0.1 --port 5198",
    "site:build": "ci-time build 'pnpm docs:build && pnpm playground:build'",
    "deploy": "ci-time deploy 'sync1 guard && pnpm site:build && wrangler deploy'",
    "lint": "astro sync --root docs && eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.mjs",
    "release:check": "pnpm typecheck && pnpm lint",
    "sync:check": "sync1 check",
    "check": "pnpm sync:check && pnpm typecheck && pnpm lint"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.38.4",
    "@eslint/js": "^9.0.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@playwright/test": "^1.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^6.1.9",
    "eslint": "^9.0.0",
    "jsdom": "^24.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.85.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
